<style>
  .sig-loader {
    position: fixed; inset: 0; z-index: 1000;
    display: grid; place-items: center;
    background: var(--paper, #FBF1E4); color: var(--ink, #4A2E1F);
    cursor: pointer;
  }
  .sig-loader.is-done { display: none; }
  .sig { width: min(70vw, 460px); height: auto; overflow: visible; }
  .sig .ink { fill: currentColor; }
  .sig .guides { display: none; }
</style>

<script>
  import { gsap } from 'gsap';

function buildSignature(root: Element, opts: { onComplete?: () => void } = {}) {
  const q = (s: string) => root.querySelector(s) as SVGPathElement;
  const prep = (el: SVGPathElement) => { const L = el.getTotalLength(); el.style.strokeDasharray = L + ' ' + L; el.style.strokeDashoffset = String(L); return L; };
  ['.g1', '.g2', '.g3', '.flower-line'].forEach((s) => prep(q(s)));
  const tl = gsap.timeline({ paused: true, onComplete: opts.onComplete });
  tl.set(q('.flower'), { scale: 0.4, rotation: -30, transformOrigin: '50% 50%', autoAlpha: 0 })
    .set(q('.sparkle'), { scale: 0, rotation: -45, transformOrigin: '50% 50%' })
    // "iel": one stroke, the way it's written
    .to(q('.g1'), { strokeDashoffset: 0, duration: 0.6, ease: 'power1.inOut' }, 0.15)
    // pen lifts, then "clemente"
    .to(q('.g2'), { strokeDashoffset: 0, duration: 1.0, ease: 'power1.inOut' }, 0.85)
    // cross the t
    .to(q('.g3'), { strokeDashoffset: 0, duration: 0.16, ease: 'power2.out' }, 1.92)
    // a beat, then the flower blooms as the dot on the i
    .to(q('.flower'), { autoAlpha: 1, duration: 0.01 }, 2.2)
    .to(q('.flower-line'), { strokeDashoffset: 0, duration: 0.45, ease: 'power2.inOut' }, 2.2)
    .to(q('.flower'), { scale: 1, rotation: 0, duration: 0.65, ease: 'back.out(2.2)' }, 2.2)
    // sparkle pops, then twinkles once
    .to(q('.sparkle'), { scale: 1, rotation: 0, duration: 0.35, ease: 'back.out(3)' }, 2.55)
    .to(q('.sparkle'), { scale: 1.3, duration: 0.14, yoyo: true, repeat: 1, ease: 'sine.inOut' }, 2.95);
  return tl;
}

  const loader = document.getElementById('sig-loader') as HTMLElement;
  const KEY = 'ic-loader-seen';
  let seen = false;
  try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function finish() {
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    gsap.to(loader, { autoAlpha: 0, duration: 0.45, ease: 'power1.out',
      onComplete: () => loader.classList.add('is-done') });
    window.removeEventListener('keydown', finish);
  }

  if (!loader) {
    // nothing to do
  } else if (seen || reduce) {
    loader.classList.add('is-done');
  } else {
    const tl = buildSignature(loader, { onComplete: () => gsap.delayedCall(0.5, finish) });
    tl.play();
    loader.addEventListener('click', () => { tl.kill(); finish(); }, { once: true });
    window.addEventListener('keydown', () => { tl.kill(); finish(); }, { once: true });
  }
</script>
