---
import { STORE_NAME, RECEIPT } from '../../data/site';
---
<section id="checkout" class="checkout" aria-labelledby="checkout-title">
  <div class="checkout__left">
    <span class="aisle__label">checkout · about</span>
    <h2 id="checkout-title" class="checkout__title split">ready to check out?</h2>
    <p class="checkout__lead">Your total comes to one product designer who draws. Here's the receipt.</p>

    <svg class="register boil" viewBox="0 0 420 300" aria-hidden="true">
      <g class="ink">
        <path d="M10 290 H410" />
        <rect x="20" y="200" width="380" height="90" rx="10" class="fill-raised" />
        <path d="M40 230 h340" class="thin" />
        <rect x="90" y="110" width="220" height="90" rx="12" class="fill-paper" />
        <rect x="120" y="40" width="160" height="60" rx="8" class="fill-ink" />
        <text x="200" y="80" text-anchor="middle" class="register__screen">$ ∞</text>
        <path d="M200 100 v10" />
        <rect x="140" y="128" width="30" height="18" rx="4" class="fill-apricot" />
        <rect x="185" y="128" width="30" height="18" rx="4" class="fill-salmon" />
        <rect x="230" y="128" width="30" height="18" rx="4" class="fill-leaf" />
        <rect x="140" y="160" width="120" height="14" rx="4" class="fill-sage" />
        <rect x="300" y="180" width="80" height="12" rx="3" class="fill-ink" />
      </g>
    </svg>
  </div>

  <div class="checkout__right">
    <div class="receipt-slot" aria-hidden="true"></div>
    <div class="receipt-clip">
      <div class="receipt" id="receipt">
        <p class="receipt__store">{STORE_NAME}</p>
        <p class="receipt__meta">receipt #001 · cashier: iel · register: 02</p>
        <hr />
        <table class="receipt__items">
          <caption class="visually-hidden">Skills</caption>
          <thead class="visually-hidden"><tr><th>Item</th><th>Qty</th><th>Price</th></tr></thead>
          <tbody>
            {RECEIPT.map((r) => (
              <tr><td>{r.item}</td><td>×{r.qty}</td><td>{r.price}</td></tr>
            ))}
          </tbody>
        </table>
        <hr />
        <p class="receipt__total"><span>total</span><span>1 product designer</span></p>
        <hr />
        <p class="receipt__about-title">about the designer</p>
        <p class="receipt__about">A short paragraph about you goes here: where you're from, what you care about in design, and what you're looking for next. Keep it warm and first person.</p>
        <div class="receipt__barcode" aria-hidden="true"></div>
        <p class="receipt__thanks">thank you for shopping!</p>
      </div>
    </div>
  </div>
</section>
