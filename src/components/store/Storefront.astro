---
import { base, STORE_NAME } from '../../data/site';

// Scalloped awning edge, built from arcs.
let scallops = 'M350 300';
for (let x = 350; x < 1250; x += 60) scallops += ' a30 24 0 0 0 60 0';
---
<section id="storefront" class="sf" aria-labelledby="sf-title">
  <h1 id="sf-title" class="visually-hidden">Hello, I'm Iel, a product designer. Designing products like little love letters.</h1>
  <div class="sf__stage">
    <div class="sf__world" id="sf-world">
      <svg class="sf__art" viewBox="0 0 1600 900" aria-hidden="true">
        <defs>
          <pattern id="awning-stripes" width="80" height="10" patternUnits="userSpaceOnUse">
            <rect width="40" height="10" fill="var(--rust)" />
            <rect x="40" width="40" height="10" fill="var(--paper-raised)" />
          </pattern>
          <clipPath id="door-clip"><rect x="762" y="332" width="276" height="488" /></clipPath>
        </defs>

        <g class="ink">
          <!-- sidewalk -->
          <path d="M0 820 Q400 816 800 821 T1600 819" />
          <path d="M120 860 h120 M520 864 h90 M1020 858 h140 M1380 866 h100" class="thin" />

          <!-- building -->
          <rect x="330" y="200" width="940" height="620" class="fill-raised" />
          <rect x="310" y="178" width="980" height="30" rx="6" class="fill-paper" />

          <!-- sign -->
          <g class="boil">
            <path d="M640 178 v-22 M960 178 v-22" />
            <rect x="560" y="70" width="480" height="96" rx="20" class="fill-paper" />
            <text x="800" y="135" text-anchor="middle" class="sf__signtext">{STORE_NAME}</text>
          </g>

          <!-- awning -->
          <rect x="350" y="246" width="900" height="56" fill="url(#awning-stripes)" />
          <path d={scallops + ' L1250 246 L350 246 Z'} fill="url(#awning-stripes)" />

          <!-- left window with the greeting -->
          <rect x="380" y="360" width="350" height="330" rx="8" class="fill-glass" />
          <path d="M405 390 l40 -20 M405 420 l70 -36" class="thin glare" />
          <text x="555" y="490" text-anchor="middle" class="sf__hello">hello,</text>
          <text x="545" y="575" text-anchor="middle" class="sf__hello">im iel</text>
          <text x="665" y="530" class="sf__q">?</text>
          <rect x="380" y="690" width="350" height="22" class="fill-paper" />

          <!-- doorway: the inside of the store -->
          <rect x="760" y="330" width="280" height="490" class="fill-sage" />
          <path d="M780 440 h240 M780 540 h240 M780 640 h240" class="thin" />
          <rect x="792" y="402" width="26" height="38" rx="4" class="fill-apricot" />
          <rect x="830" y="412" width="22" height="28" rx="8" class="fill-salmon" />
          <rect x="930" y="500" width="30" height="40" rx="4" class="fill-leaf" />
          <rect x="970" y="508" width="24" height="32" rx="10" class="fill-apricot" />
          <rect x="800" y="600" width="28" height="40" rx="6" class="fill-salmon" />
          <g clip-path="url(#door-clip)">
            <g id="door-l">
              <rect x="762" y="332" width="138" height="488" class="fill-glass door" />
              <path d="M884 520 v80" class="handle" />
            </g>
            <g id="door-r">
              <rect x="900" y="332" width="138" height="488" class="fill-glass door" />
              <path d="M916 520 v80" class="handle" />
            </g>
          </g>
          <rect x="760" y="330" width="280" height="490" fill="none" />

          <!-- right window with an OPEN sign -->
          <rect x="1070" y="360" width="170" height="330" rx="8" class="fill-glass" />
          <path d="M1120 360 l35 60 l35 -60" class="thin" />
          <rect x="1105" y="420" width="100" height="44" rx="8" class="fill-rust" />
          <text x="1155" y="451" text-anchor="middle" class="sf__open">open</text>

          <!-- plants by the door -->
          <path d="M700 820 l10 -60 h40 l10 60 Z" class="fill-salmon" />
          <path d="M730 760 q-30 -40 -10 -80 q20 30 10 80 q10 -50 40 -70 q0 50 -40 70" class="fill-leaf" />

          <!-- chalkboard A-frame with the tagline -->
          <g class="boil">
            <path d="M1330 820 L1365 560 h170 L1570 820" />
            <rect x="1360" y="575" width="180" height="200" rx="10" class="fill-ink" />
            <text x="1450" y="620" text-anchor="middle" class="sf__chalk sf__chalk--small">today's special</text>
            <text x="1450" y="665" text-anchor="middle" class="sf__chalk">products</text>
            <text x="1450" y="700" text-anchor="middle" class="sf__chalk">designed like</text>
            <text x="1450" y="745" text-anchor="middle" class="sf__chalk">little love letters</text>
          </g>
        </g>
      </svg>

      <div class="walker" id="sf-walker" style={`--sprite: url(${base}hero/walk-sprite.webp)`} role="img" aria-label="Iel, in round glasses and a scarf, pushing a shopping cart"></div>
    </div>
    <canvas class="sf__petals" id="sf-petals" aria-hidden="true"></canvas>
    <div class="sf__veil" id="sf-veil" aria-hidden="true"></div>
    <p class="sf__hint" id="sf-hint" aria-hidden="true">scroll to step inside ↓</p>
  </div>
</section>
