---
// Storefront scene, built from Iel's drawn layers (public/store/*.webp).
// Each layer sits where it was in the 3840 × 2160 PSD, so positions are
// percentages of that canvas. Re-export a layer with the same name to update it.
import { base } from '../../data/site';

const W = 3840, H = 2160;
type Layer = { name: string; x: number; y: number; w: number; h: number; alt?: string; cls?: string };
// Back to front, in the same order as the PSD.
// Ground and bushes repeat sideways so they reach the edges of any screen.
// tileW is the width of one repeat in canvas px: 3840 for the current drawings,
// or the width of the seamless tile once it's drawn (e.g. 1920).
const strips = [
  { name: 'backdrop-bushes', y: 1565, h: 370, tileW: 3840 },
  { name: 'ground', y: 1929, h: 231, tileW: 3840 },
];
const layers: Layer[] = [
  { name: 'doorway-inside', x: 2064, y: 1188, w: 508, h: 636 },
  { name: 'building', x: 1002, y: 21, w: 1965, h: 1970 },
  { name: 'window-sign', x: 1381, y: 1309, w: 420, h: 203 },
  { name: 'store-name', x: 1701, y: 369, w: 524, h: 271 },
  { name: 'fruit-stand', x: 1228, y: 1620, w: 759, h: 214, cls: 'sf-layer--front' },
  { name: 'chalkboard', x: 2636, y: 1492, w: 345, h: 521, cls: 'sf-layer--front' },
];
// The two glass doors slide apart inside the doorway, which hides them as they go.
const doorway = { x: 2056, y: 1151, w: 2576 - 2056, h: 1943 - 1151 };
const doors = [
  { id: 'door-l', name: 'door-left', x: 2056, y: 1152, w: 285, h: 791 },
  { id: 'door-r', name: 'door-right', x: 2291, y: 1151, w: 285, h: 791 },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const place = (l: { x: number; y: number; w: number }, ox = 0, oy = 0, ow = W, oh = H) =>
  `left:${pct(l.x - ox, ow)};top:${pct(l.y - oy, oh)};width:${pct(l.w, ow)}`;
---
<section id="storefront" class="sf" aria-labelledby="sf-title" data-base={base}>
  <h1 id="sf-title" class="visually-hidden">iel's market. Hello, I'm Iel, a product designer, and I'm open for hiring. Designing products like little love letters.</h1>
  <div class="sf__stage">
    <div class="sf__world" id="sf-world" aria-hidden="true">
      {strips.map((st) => (
        <div class={`sf-strip sf-strip--${st.name}`}
          style={`top:${pct(st.y, H)};height:${pct(st.h, H)};background-image:url(${base}store/${st.name}.webp);background-size:${((st.tileW / W) * 100 / 3).toFixed(4)}% 100%`}></div>
      ))}
      {layers.slice(0, 2).map((l) => (
        <img class={`sf-layer ${l.cls ?? ''}`} src={`${base}store/${l.name}.webp`} alt="" width={l.w} height={l.h} style={place(l)} decoding="async" fetchpriority={l.name === 'building' ? 'high' : 'auto'} />
      ))}

      <div class="sf-doorway" style={`${place(doorway)};height:${pct(doorway.h, H)}`}>
        {doors.map((d) => (
          <img id={d.id} class="sf-door" src={`${base}store/${d.name}.webp`} alt="" width={d.w} height={d.h}
            style={place(d, doorway.x, doorway.y, doorway.w, doorway.h)} decoding="async" />
        ))}
      </div>

      {layers.slice(2).map((l) => (
        <img class={`sf-layer ${l.cls ?? ''}`} src={`${base}store/${l.name}.webp`} alt="" width={l.w} height={l.h} style={place(l)} decoding="async" />
      ))}

      <div class="walker" id="sf-walker" style={`--sprite: url(${base}hero/walk-sprite.webp)`}></div>
    </div>
    <canvas class="sf__petals" id="sf-petals" aria-hidden="true"></canvas>
    <div class="sf__veil" id="sf-veil" aria-hidden="true"></div>
    <p class="sf__hint" id="sf-hint" aria-hidden="true">scroll to step inside ↓</p>
  </div>
</section>
