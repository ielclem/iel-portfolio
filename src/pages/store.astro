---
import '../styles/global.css';
import '../styles/store.css';
import { base, PROJECTS } from '../data/site';
import StoreNav from '../components/store/StoreNav.astro';
import Storefront from '../components/store/Storefront.astro';
import Directory from '../components/store/Directory.astro';
import Aisles from '../components/store/Aisles.astro';
import Checkout from '../components/store/Checkout.astro';
import Closing from '../components/store/Closing.astro';
import ExpressLane from '../components/store/ExpressLane.astro';
---
<html lang="en" data-mode="store">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iel Clemente · Product Designer</title>
    <meta name="description" content="Iel Clemente is a product designer who draws. Walk through the store, or switch to recruiter mode for the quick version." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={`${base}hero/walk-sprite.webp`} as="image" />
    <script is:inline>
      // Pick the mode before first paint so the express lane never flashes the store.
      try {
        if (location.hash === '#recruiter' || location.hash === '#express' || localStorage.getItem('ic-express') === '1') {
          document.documentElement.dataset.mode = 'express';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="boil" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1" />
        <feDisplacementMap in="SourceGraphic" scale="2.5" />
      </filter>
    </svg>

    <a class="visually-hidden" href="#directory">Skip to the projects</a>
    <StoreNav />

    <main class="store">
      <Storefront />
      <Directory />
      <Aisles />
      <Checkout />
      <Closing />
    </main>

    <nav class="aisle-bar" id="aisle-bar" aria-label="Jump to an aisle">
      <span class="aisle-bar__label" aria-hidden="true">aisle</span>
      {PROJECTS.map((p) => (
        <a href={`#aisle-${p.aisle}`} data-jump={`aisle-${p.aisle}`} data-aisle={p.aisle} aria-label={`Aisle ${p.aisle}: ${p.title}`}>{p.aisle}</a>
      ))}
      <a href="#checkout" data-jump="checkout" class="aisle-bar__checkout">checkout</a>
    </nav>
    <div class="jump-veil" id="jump-veil" aria-hidden="true"></div>

    <main class="express-main">
      <ExpressLane />
    </main>

    <script src="../scripts/store.ts"></script>
  </body>
</html>
